# syntax=docker/dockerfile:1
# Cross-builds Celeste64 for linux/arm64 on Ubuntu 20.04 (glibc 2.31).
#
# Usage (cross-build from any host, e.g. Windows with Docker Desktop):
#   docker buildx create --use --name cross
#   docker buildx build --platform linux/arm64 --load -t celeste64-arm64 .
#   docker create --name tmp celeste64-arm64
#   docker cp tmp:/out ./artifacts/arm64
#   docker rm tmp
#
# Custom SDL2: put your libs in ./sdl2/{include,lib} and add:
#   --build-arg SDL2_DIR=sdl2
# The build prefers (in order): your custom SDL2, an installed sdl2.pc,
# otherwise SDL2 2.30.0 is fetched and built statically.

FROM arm64v8/ubuntu:20.04

ARG DOTNET_CHANNEL=8.0
ARG SDL2_DIR=

ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    PATH="/usr/share/dotnet:${PATH}"

# toolchain + .NET 8 runtime prerequisites + GLES/DRM headers + ALSA (FMOD)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake pkg-config git ca-certificates wget curl \
        libdrm-dev libgbm-dev libegl1-mesa-dev libgles2-mesa-dev \
        libudev-dev libasound2-dev \
        libc6 libgcc-s1 libgssapi-krb5-2 libicu66 libssl1.1 libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/*

# .NET 8 SDK (Ubuntu 20.04 arm64 is a supported distro)
RUN wget -q https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel ${DOTNET_CHANNEL} --install-dir /usr/share/dotnet \
    && rm /tmp/dotnet-install.sh

WORKDIR /src
COPY . .

# optional custom SDL2 (see header comment)
# ARG SDL2_DIR is consumed below; only used if non-empty.

# Build the native FosterPlatform with OpenGL ES 3.0.
# NOTE: build natively for the target glibc; do not build on jammy and ship to focal.
RUN cmake -S Vendor/Foster/Platform -B build/native \
        -DCMAKE_BUILD_TYPE=Release \
        -DFOSTER_OPENGLES=ON \
        -DFOSTER_LTO=ON \
        ${SDL2_DIR:+-DFOSTER_SDL2_LIBS=/src/${SDL2_DIR}/lib/libSDL2-2.0.so.0} \
        ${SDL2_DIR:+-DFOSTER_SDL2_INCLUDE=/src/${SDL2_DIR}/include/SDL2} \
    && cmake --build build/native -j$(nproc)

# Publish the game (self-contained, single file) for linux-arm64
RUN dotnet publish Celeste64.csproj -c Release -r linux-arm64 --self-contained true -o /out
